# Safe Code Group — Apache settings for public_html (HostGator)
#
# Other folders in public_html are other sites' document roots, and this file
# also applies to them. So everything below is limited to safecodeg.com hosts,
# except the dotfile protection, which keeps the server's existing behaviour
# for every site. /.well-known/ stays reachable so AutoSSL can renew
# certificates over plain HTTP.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Hide dotfiles and dot-folders (.git, backups, ...) on every site
  RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]

  # safecodeg.com -> https://www.safecodeg.com
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^safecodeg\.com$ [NC]
  RewriteRule ^ https://www.safecodeg.com%{REQUEST_URI} [R=301,L]

  # http://www.safecodeg.com -> https://www.safecodeg.com
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.safecodeg\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.safecodeg.com%{REQUEST_URI} [R=301,L]
</IfModule>

<If "%{HTTP_HOST} =~ /^(www\.)?safecodeg\.com$/i">
  <IfModule mod_headers.c>
    # Browsers remember to use HTTPS for 1 year (sent only over HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  </IfModule>

  <IfModule mod_expires.c>
    # css/js are versioned with ?v=... in index.html, so they can be cached
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/html "access plus 0 seconds"
  </IfModule>
</If>
